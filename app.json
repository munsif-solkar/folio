{
  "expo": {
    "name": "Folio",
    "slug": "folio-ledger",
    "version": "1.0.0",
    "scheme": "folio",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.folio.ledger"
    },
    "android": {
      "package": "com.folio.ledger",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7FA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 144
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d0cba57d-e45b-4ce2-9070-0169d1e76278"
      }
    },
    "owner": "munsifsolkar"
  }
}
